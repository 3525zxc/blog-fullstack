# ---- 数据库（MySQL）----
# 方式一：整串连接串（推荐，sqlpub 控制台可直接复制）
# DATABASE_URL=mysql+pymysql://用户名:密码@主机:3306/库名?charset=utf8mb4
# 方式二：离散变量（自动拼装）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=linblog

# ---- 安全 ----
# 生产环境务必改成随机长字符串
SECRET_KEY=dev-secret-please-change-me

# ---- 服务 ----
PORT=5000
